# URL of the Solvia web app (the sign-in buttons point here)
VITE_APP_URL=http://localhost:5173
# ISO 4217 currency used to format prices
VITE_CURRENCY=PEN
# Base URL of the API (the access request form posts here). `/api` goes through the proxy.
VITE_API_URL=/api
# Where the Vite dev server proxies `/api` to (the backend)
VITE_PROXY_TARGET=http://localhost:4000
